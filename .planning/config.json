{
  "mode": "yolo",
  "granularity": "standard",
  "model_profile": "quality",
  "model_overrides": {
    "gsd-planner": "openai/gpt-5.4",
    "gsd-roadmapper": "openai/gpt-5.4",
    "gsd-executor": "openai/gpt-5.4",
    "gsd-phase-researcher": "openai/gpt-5.4",
    "gsd-project-researcher": "openai/gpt-5.4",
    "gsd-research-synthesizer": "openai/gpt-5.4",
    "gsd-debugger": "openai/gpt-5.4",
    "gsd-codebase-mapper": "openai/gpt-5.4",
    "gsd-verifier": "openai/gpt-5.4",
    "gsd-plan-checker": "openai/gpt-5.4",
    "gsd-integration-checker": "openai/gpt-5.4",
    "gsd-nyquist-auditor": "openai/gpt-5.4",
    "gsd-pattern-mapper": "openai/gpt-5.4",
    "gsd-ui-researcher": "openai/gpt-5.4",
    "gsd-ui-checker": "openai/gpt-5.4",
    "gsd-ui-auditor": "openai/gpt-5.4",
    "gsd-doc-writer": "openai/gpt-5.4",
    "gsd-doc-verifier": "openai/gpt-5.4"
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": false,
    "nyquist_validation": true,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "discuss_mode": "discuss",
    "research_before_questions": true,
    "skip_discuss": true,
    "use_worktrees": true,
    "code_review_command": null,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "cross_ai_execution": false,
    "cross_ai_command": "",
    "cross_ai_timeout": 300
  },
  "planning": {
    "commit_docs": true,
    "search_gitignored": false,
    "sub_repos": []
  },
  "parallelization": {
    "enabled": true,
    "plan_level": true,
    "task_level": true,
    "skip_checkpoints": true,
    "max_concurrent_agents": 15,
    "min_plans_for_parallel": 2
  },
  "gates": {
    "confirm_project": false,
    "confirm_phases": false,
    "confirm_roadmap": false,
    "confirm_breakdown": false,
    "confirm_plan": false,
    "execute_next_plan": false,
    "issues_review": true,
    "confirm_transition": false
  },
  "safety": {
    "always_confirm_destructive": true,
    "always_confirm_external_services": true
  },
  "hooks": {
    "context_warnings": true
  },
  "git": {
    "branching_strategy": "phase",
    "quick_branch_template": null
  },
  "project_code": "CZP",
  "agent_skills": {},
  "claude_md_path": "./AGENTS.md"
}
