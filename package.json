{
  "name": "cobrazap",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test --continue=dependencies-successful",
    "test:integration": "turbo run test:integration --continue=dependencies-successful",
    "test:e2e": "turbo run test:e2e --continue=dependencies-successful",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres redis"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
